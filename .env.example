# Optional: enables Gemini analysis for live camera feeds. Simulation scans work without it.
GEMINI_API_KEY=

# Required for the first production admin login. Use a unique password with at least 8 characters.
ADMIN_PASSWORD=

# Web server port (defaults to 3000).
PORT=3000

# Optional directory for the admin password record and active sessions.
TRINETRA_LOCAL_DATA_DIR=

# Exact hostnames allowed for server-side remote image analysis (comma-separated).
# Private, loopback, link-local, reserved, and redirect-to-blocked addresses are always denied.
TRINETRA_ALLOWED_IMAGE_HOSTS=

# Unauthorized incident records/photos are pruned hourly and on access/write.
TRINETRA_INCIDENT_RETENTION_DAYS=90
TRINETRA_INCIDENT_MAX_RECORDS=1000
